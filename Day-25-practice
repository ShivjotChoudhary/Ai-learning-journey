#Step 6:- outlier treatment:-
#Step 1: Calculate Q1, Q3
#🚀 Code Explanation (Line by Line)



#🔹 Step 1: Q1
Q1 = df["Fare"].quantile(0.25)
#👉 Finds value below which 25% data lies

#🔹 Step 2: Q3
Q3 = df["Fare"].quantile(0.75)
#👉 Finds value below which 75% data lies

#🔹 Step 3: IQR
IQR = Q3 - Q1
#👉 Range of middle 50% data

#🔹 Step 4: Limits
lower = Q1 - 1.5 * IQR
upper = Q3 + 1.5 * IQR
#👉 Defines acceptable range

#🔹 Step 5: Detect Outliers
outliers = df[(df["Fare"] < lower) | (df["Fare"] > upper)]
#👉 Finds rows outside range

#🔹 Step 6: Remove Outliers
df = df[(df["Fare"] >= lower) & (df["Fare"] <= upper)]
# 👉 Keeps only normal data

